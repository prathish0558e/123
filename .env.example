# Production domain for SEO (canonical URLs, og:url, sitemap.xml, robots.txt).
# Set it once the domain is live, then run:  npm run seo:generate && npm run build
# e.g. VITE_SITE_URL=https://tctfashionhub.in
VITE_SITE_URL=

# Set this in Vercel Project Settings > Environment Variables to enable UPI app payments.
VITE_UPI_ID=tctfashionhub@okicici

# Google Identity Services client ID (use the exact same value in both variables).
# For local development, add http://localhost:5173 as an authorized
# JavaScript origin in Google Cloud Console. This ID-token flow does not
# require an authorized redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Required on Vercel for signing the Google customer session cookie.
# Use a long random value and keep it server-only.
GOOGLE_SESSION_SECRET=replace-with-a-long-random-secret

# --- Admin panel (http://localhost:5173/admin) -------------------------------
# These are used ONCE, only when no admin account exists yet. The password is
# stored as a scrypt hash + random salt in backend/data/admins.json — never in
# plain text. Leave them out to keep the built-in first-boot account
# (admin / Tct@Admin2026), then change the password inside the panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
